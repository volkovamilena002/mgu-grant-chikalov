{
  "_comment": "Необязательные MCP-серверы для Claude Code: скопируйте в .mcp.json. strat — реестры агента как MCP-инструменты (только stdlib); в Claude Code агент и так работает через CLI, поэтому сервер выключен по умолчанию (23 описания инструментов в контексте стоят токенов). markitdown и fetch требуют uv (https://docs.astral.sh/uv/). На macOS/Linux замените python на python3 при необходимости.",
  "mcpServers": {
    "strat": {
      "command": "python",
      "args": ["tools/strat_mcp.py"]
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
